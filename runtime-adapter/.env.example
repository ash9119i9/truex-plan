# Shared secret the platform sends as a bearer token (at least 32 characters).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RUNTIME_ADAPTER_TOKEN=
# Absolute directory holding every chat's Codex home and workspace. Keep it.
RUNTIME_STATE_DIR=
HOST=127.0.0.1
PORT=4400
