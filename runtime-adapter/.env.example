# Shared secret the platform sends as a bearer token (at least 32 characters).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RUNTIME_ADAPTER_TOKEN=
# Absolute directory holding every chat's Codex home and workspace. Keep it.
RUNTIME_STATE_DIR=
HOST=127.0.0.1
PORT=4400
# RUNTIME_MAX_PROCESSES=20
# RUNTIME_IDLE_MS=600000
# RUNTIME_DRAIN_MS=30000
# A reply stops (COMMAND_LIMIT) after this many failed commands, or this many
# commands in all, so a model can't loop on tools that aren't there.
# RUNTIME_MAX_FAILED_COMMANDS=12
# RUNTIME_MAX_COMMANDS=120
# RUNTIME_CODING_ENABLED=1
# Python toolchain for coding runs: run `npm run toolchain:setup` at the repo
# root and paste the line it prints.
# RUNTIME_TOOLCHAIN_DIRS=
