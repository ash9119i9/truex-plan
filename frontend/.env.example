PORT=3000
# Server-side address of the platform. The browser never sees it: it talks only
# to this app's own origin, and app/api and app/auth forward each request here
# (cookies, event streams and downloads included). Read at request time.
PLATFORM_INTERNAL_URL=http://localhost:4000
# Pass the incoming X-Forwarded-For upstream only behind a trusted proxy that appends the real address (production Ingress): on|off
TRUST_FORWARDED_FOR=off
