{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../shared/mcp-caller-token.ts",
    "../shared/gateway-token.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
