# Model gateway: translates Codex's Responses API calls to Chat Completions,
# Anthropic and Gemini providers. Runs as its own service.
PORT=4200
# 0.0.0.0 in containers; keep it private (internal load balancer / VPC only).
HOST=127.0.0.1
# Same database as the platform: provider keys come from truex_models.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=truex
# Must equal MODEL_GATEWAY_SECRET in platform/.env. At least 32 characters,
# e.g. `openssl rand -base64 48`.
MODEL_GATEWAY_SECRET=
# How long a model profile is cached (ms). Disabling a profile takes effect
# within this window.
# PROFILE_CACHE_TTL_MS=30000
# Profiles may store `apiKeySecretArn` (AWS Secrets Manager) instead of a
# plaintext apiKey; the gateway's IAM role then needs GetSecretValue.
# AWS_REGION=us-east-1
# How long in-flight model streams may finish after SIGTERM (ms). Keep the
# load balancer's deregistration delay and the task stop timeout above this.
# DRAIN_GRACE_MS=30000
# Fail a provider call that sends no data within this time (ms), or goes
# silent mid-stream, so Codex retries instead of waiting ~5 minutes. 0 disables.
# A profile's `firstByteTimeoutMs` overrides the first value for that model.
# UPSTREAM_FIRST_BYTE_TIMEOUT_MS=60000
# UPSTREAM_IDLE_TIMEOUT_MS=120000
