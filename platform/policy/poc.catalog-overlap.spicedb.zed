  permission conversation_trace_read = version->conversation_trace_read
  permission conversation_goal_read = version->conversation_goal_read
  permission conversation_goal_update = version->conversation_goal_update
  permission conversation_goal_review = version->conversation_goal_review
  permission conversation_compact = version->conversation_compact
  permission document_upload = version->document_upload
  permission support_approve_access = version->support_approve_access
}
definition az_overlap_v2_document_version {
  relation scope: az_overlap_v2_workspace
  permission owned = conversation->owned
  permission content_read = conversation->conversation_read
  relation conversation: az_overlap_v2_conversation
  permission document_read = scope->cap_document_read & conversation->conversation_read
  permission document_download = scope->cap_document_download & conversation->conversation_read
  permission document_delete = scope->cap_document_delete & conversation->owned
}
definition az_overlap_v2_document {
  relation version: az_overlap_v2_document_version with az_overlap_v2_active_version
  permission owned = version->owned
  permission content_read = version->content_read
  permission document_read = version->document_read
  permission document_download = version->document_download
  permission document_delete = version->document_delete
}
definition az_overlap_v2_project_version {
  relation scope: az_overlap_v2_workspace
  relation owner: az_overlap_v2_principal
  relation reader: az_overlap_v2_principal | az_overlap_v2_group#member | az_overlap_v2_role#assignee
  permission owned = owner
  permission content_read = owner + reader
  permission project_read = scope->cap_project_read & owner
  permission project_update = scope->cap_project_update & owner
  permission project_delete = scope->cap_project_delete & owner
}
definition az_overlap_v2_project {
  relation version: az_overlap_v2_project_version with az_overlap_v2_active_version
  permission owned = version->owned
  permission content_read = version->content_read
  permission project_read = version->project_read
  permission project_update = version->project_update
  permission project_delete = version->project_delete
}
definition az_overlap_v2_connector_version {
  relation scope: az_overlap_v2_workspace
  relation owner: az_overlap_v2_principal
  relation reader: az_overlap_v2_principal | az_overlap_v2_group#member | az_overlap_v2_role#assignee
  permission owned = owner
  permission content_read = owner + reader + manager
  relation manager: az_overlap_v2_role#assignee
  relation allowed: az_overlap_v2_principal | az_overlap_v2_group#member | az_overlap_v2_role#assignee
  permission connector_read = scope->cap_connector_read & content_read
  permission connector_update = scope->cap_connector_update & (owner + manager)
  permission connector_delete = scope->cap_connector_delete & (owner + manager)
  permission connector_manage = scope->cap_connector_manage & (owner + manager)
  permission connector_attach = scope->cap_connector_attach & (owner + manager)
  permission connector_use = scope->cap_connector_use & (owner + allowed)
  permission tool_discover = scope->cap_tool_discover & (owner + allowed)
  permission tool_read = scope->cap_tool_read & (owner + allowed)
  permission tool_invoke = scope->cap_tool_invoke & (owner + allowed)
  permission tool_write = scope->cap_tool_write & (owner + allowed)
}
definition az_overlap_v2_connector {
  relation version: az_overlap_v2_connector_version with az_overlap_v2_active_version
  permission owned = version->owned
  permission content_read = version->content_read
  permission connector_read = version->connector_read
  permission connector_update = version->connector_update
  permission connector_delete = version->connector_delete
  permission connector_manage = version->connector_manage
  permission connector_attach = version->connector_attach
  permission connector_use = version->connector_use
  permission tool_discover = version->tool_discover
  permission tool_read = version->tool_read
  permission tool_invoke = version->tool_invoke
  permission tool_write = version->tool_write
}
