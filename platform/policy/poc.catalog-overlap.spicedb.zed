definition az_overlap_v2_group_version {
  relation member: az_overlap_v2_principal | az_overlap_v2_group#member
}
definition az_overlap_v2_group {
  relation version: az_overlap_v2_group_version with az_overlap_v2_active_version
  permission member = version->member
}
definition az_overlap_v2_role_version {
  relation assignee: az_overlap_v2_principal | az_overlap_v2_workload | az_overlap_v2_group#member
}
definition az_overlap_v2_role {
  relation version: az_overlap_v2_role_version with az_overlap_v2_active_version
