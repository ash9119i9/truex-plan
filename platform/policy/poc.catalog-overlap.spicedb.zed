definition az_overlap_v2_agent_version {
  relation scope: az_overlap_v2_workspace
  relation owner: az_overlap_v2_principal
  relation reader: az_overlap_v2_principal | az_overlap_v2_group#member | az_overlap_v2_role#assignee
  permission owned = owner
  permission content_read = owner + reader
  permission agent_read = scope->cap_agent_read & content_read
  permission agent_update = scope->cap_agent_update & owner
  permission agent_delete = scope->cap_agent_delete & owner
  permission agent_publish = scope->cap_agent_publish & owner
  permission agent_use = scope->cap_agent_use & content_read
  permission conversation_create = scope->cap_conversation_create & agent_use
}
definition az_overlap_v2_agent {
  relation version: az_overlap_v2_agent_version with az_overlap_v2_active_version
  permission owned = version->owned
  permission content_read = version->content_read
  permission agent_read = version->agent_read
  permission agent_update = version->agent_update
  permission agent_delete = version->agent_delete
  permission agent_publish = version->agent_publish
  permission agent_use = version->agent_use
  permission conversation_create = version->conversation_create
}
definition az_overlap_v2_conversation_version {
  relation scope: az_overlap_v2_workspace
  relation owner: az_overlap_v2_principal
  relation reader: az_overlap_v2_principal | az_overlap_v2_group#member | az_overlap_v2_role#assignee
  relation emergency_reader: az_overlap_v2_principal with az_overlap_v2_emergency_unexpired
  permission owned = owner
  permission content_read = owner + reader + emergency_reader
  permission conversation_read = scope->cap_conversation_read & owner
  permission conversation_send = scope->cap_conversation_send & owner
  permission conversation_interrupt = scope->cap_conversation_interrupt & owner
  permission conversation_approve = scope->cap_conversation_approve & owner
  permission conversation_approval_mode_manage = scope->cap_conversation_approval_mode_manage & owner
  permission conversation_settings_manage = scope->cap_conversation_settings_manage & owner
  permission conversation_archive = scope->cap_conversation_archive & owner
  permission conversation_fork = scope->cap_conversation_fork & owner
  permission conversation_resume = scope->cap_conversation_resume & owner
  permission conversation_delete = scope->cap_conversation_delete & owner
  permission conversation_share = scope->cap_conversation_share & owner
  permission conversation_trace_read = scope->cap_conversation_trace_read & content_read
  permission conversation_goal_read = scope->cap_conversation_goal_read & content_read
  permission conversation_goal_update = scope->cap_conversation_goal_update & owner
  permission conversation_goal_review = scope->cap_conversation_goal_review & owner
  permission conversation_compact = scope->cap_conversation_compact & owner
  permission document_upload = scope->cap_document_upload & owner
  permission support_approve_access = scope->cap_support_approve_access & owner
}
definition az_overlap_v2_conversation {
  relation version: az_overlap_v2_conversation_version with az_overlap_v2_active_version
  permission owned = version->owned
  permission content_read = version->content_read
  permission conversation_read = version->conversation_read
  permission conversation_send = version->conversation_send
  permission conversation_interrupt = version->conversation_interrupt
  permission conversation_approve = version->conversation_approve
