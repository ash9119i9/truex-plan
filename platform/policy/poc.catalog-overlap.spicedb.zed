// Generated from authorization-model.ts. Candidate only: no production guards yet.
caveat az_overlap_v2_active_version(active map<string>, key string, revision string) {
  key in active && active[key] == revision
}
caveat az_overlap_v2_emergency_unexpired(current_time timestamp, expires_at timestamp) {
  current_time < expires_at
}
definition az_overlap_v2_principal {}
