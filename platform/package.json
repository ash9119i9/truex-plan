{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/platform/src/index.js",
    "build": "tsc",
    "test": "tsx --test --test-concurrency=4 test/*.test.ts",
    "test:authz": "tsx --test --test-concurrency=4 test/authz-*.test.ts",
    "test:authz:types": "tsc --project tsconfig.authz.json --noEmit",
    "test:authz:integration": "tsx --test --test-concurrency=4 test/authz-integration/*.test.ts",
    "test:authz:faults": "tsx --test --test-concurrency=1 test/authz-faults/*.test.ts",
    "authz:benchmark": "tsx scripts/authz-benchmark.ts",
    "authz:benchmark:lists": "tsx scripts/authz-list-benchmark.ts",
    "authz:benchmark:reads": "tsx scripts/authz-read-benchmark.ts",
    "authz:benchmark:history": "tsx scripts/authz-history-benchmark.ts",
    "authz:identity:backfill": "tsx scripts/authz-identity-backfill.ts",
    "authz:model:generate": "tsx scripts/authz-model.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1146.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@smithy/node-http-handler": "^4.12.1",
    "dotenv": "^17.2.0",
    "jose": "6.2.12",
    "mongodb": "^6.19.0",
    "openid-client": "6.8.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^10.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
