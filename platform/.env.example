PORT=4000
HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=truex
AGENT_CORE_URLS=http://127.0.0.1:4100
# Set this to use the deployed Bedrock AgentCore runtime instead of local URLs.
AGENTCORE_RUNTIME_ARN=
AGENT_WORKSPACE=../.runtime/workspace
FRONTEND_ORIGIN=http://localhost:3000
# Optional model gateway for non-Responses providers (wireApi chat/anthropic/gemini).
# Leave unset for direct-only; Responses profiles never use the gateway.
# The gateway runs separately with model-gateway/.env; its secret must match.
# Secret: at least 32 random characters, e.g. `openssl rand -base64 48`.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_SECRET=
# Identity. AUTH_MODE=poc for the POC container: one shared user and tenant;
# Google sign-in, invitations, email delivery and the admin API are disabled.
# It works with NODE_ENV=production and ignores client user/tenant headers.
# No GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET or RESEND_API_KEY is needed.
# AUTH_MODE=dev enables local test header overrides; google enables sign-in.
# dev: every request runs as DEV_USER_ID with DEV_USER_ROLE (admin | user) in
# the dev tenant. DEV_USER_HEADER=on lets X-Truex-User (and X-Truex-Role) pick
# another user for local two-user testing; never enable it where untrusted
# clients can reach. The dev resolvers refuse to start under NODE_ENV=production.
# In dev mode a state-changing request without an Origin header is allowed (for
# curl and tests); a foreign Origin is refused in both modes.
AUTH_MODE=poc
DEV_USER_ID=dev-user
DEV_USER_ROLE=admin
DEV_USER_HEADER=
# google: session cookies from Google sign-in. Refuses to start without
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and FRONTEND_ORIGIN.
# Session cookies are __Host-truex_session / __Host-truex_admin with Secure when
# the matching origin is https, and truex_session / truex_admin without Secure
# on plain-http dev origins (browsers drop __Host- cookies without Secure).
# ADMIN_ORIGIN: the admin dashboard's public origin; also allowed by CORS/CSRF.
ADMIN_ORIGIN=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the main app; Google redirects to
# ${APP_PUBLIC_URL}/auth/google/callback. Defaults to FRONTEND_ORIGIN.
APP_PUBLIC_URL=http://localhost:3000
# Tests only: points sign-in at a fake OIDC issuer. Leave unset for Google.
# GOOGLE_ISSUER_URL=http://127.0.0.1:9999
# Admin dashboard login (dev/google only). One account, no users table.
# Generate the hash with `npm run admin -- hash-password` (reads stdin).
# Format: scrypt$N$r$p$<saltB64>$<hashB64>. Unset hash = admin login disabled;
# there is never a default password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Public URL of the admin dashboard (admin.<domain>).
ADMIN_PUBLIC_URL=http://localhost:3001
# Invite emails via Resend. Unset key = links are logged instead of sent
# (development only). With NODE_ENV=production and no key the platform still
# starts: invitations then show "not sent" and the link is never logged, so
# issue them with `npm run tenant -- invite` instead. Public demo sign-up needs
# no email at all. Ignored in AUTH_MODE=poc, where invitation routes are off.
RESEND_API_KEY=
# Override for tests or a proxy; defaults to https://api.resend.com.
RESEND_API_URL=
# Must be on a domain verified in Resend, e.g. "Truex <invites@yourdomain.com>".
INVITE_FROM_EMAIL=Truex <invites@example.com>
# Express "trust proxy". Leave unset when browsers reach the platform directly.
# When a forwarder sets X-Forwarded-For, set it so req.ip (and the per-IP
# /auth rate limit) sees the browser, not the forwarder: `loopback` in dev,
# the trusted forwarder hop (e.g. `1` or the forwarder's subnet).
TRUST_PROXY=
# Optional: read compatibility for previously encrypted MCP credentials only.
# New keys are stored directly in apiKey; saves and scope migration need no key.
# Retain original keys while apiKeyEnc records exist, or replace those tokens
# through Connected tools. Keys must decode to exactly 32 bytes from base64.
# MCP_ENCRYPTION_KID identifies KEY; KEYS lists additional kid:base64 pairs.
MCP_ENCRYPTION_KEY=
MCP_ENCRYPTION_KID=k1
MCP_ENCRYPTION_KEYS=
# MCP URLs that are, or resolve to, loopback, link-local (incl. 169.254.169.254),
# private or CGNAT addresses are rejected on save and at every chat start.
# Comma-separated hostnames or IPs listed here are exempt (e.g. an internal MCP).
MCP_ALLOWED_PRIVATE_HOSTS=
# on: reject plain http:// MCP URLs. Otherwise they are saved with a warning.
MCP_REQUIRE_HTTPS=

# ---- Google sign-in and the public demo (AUTH_MODE=google) ----------------
# Google mode needs MongoDB as a replica set (sign-up and invitations use
# catalog transactions). Name the catalog explicitly in an authenticated
# deployment; the fallback to MONGO_DB exists only for older setups.
CATALOG_MONGO_DB=
# Public demo: the id of ONE registered tenant that may admit anyone with a
# Google account. A tenant id, never a database name, and never "default".
# Unset = no open sign-up. Provision it with `npm run tenant -- provision-demo`.
DEMO_TENANT_ID=
# The shared ceilings have no defaults: unset means the demo admits no one.
# New turns per person per UTC day (default 50).
DEMO_DAILY_TURNS_PER_USER=
# New turns across the whole demo per UTC day.
DEMO_DAILY_TURNS_GLOBAL=
# New accounts per UTC day.
DEMO_DAILY_SIGNUPS=
# How long "may people join the demo?" is reused, in ms (default 30000).
DEMO_CACHE_MS=
# Per-person ceilings (defaults in brackets).
AGENTS_PER_USER_MAX=
MCP_PER_USER_MAX=
STREAMS_PER_USER_MAX=
# How often an open conversation stream re-checks that its reader may still
# read it, in ms (default 10000, at most 25000). Revocation takes up to this long.
STREAM_REVALIDATE_MS=
# Days to keep security audit rows (default 365).
AUDIT_RETENTION_DAYS=
