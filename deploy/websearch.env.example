# Copy to deploy/websearch.env (ignored by Git).
# Generate different values with: openssl rand -hex 32
# Both secrets must contain at least 32 characters. Replace the placeholders.
SEARXNG_SECRET=
WEB_SERVICE_TOKEN=
CRAWL4AI_API_TOKEN=

# Agent-core running on the host uses these values and the same WEB_SERVICE_TOKEN.
WEB_SEARCH=on
WEB_SERVICE_URL=http://127.0.0.1:4400

# Optional reader: enable this flag in agent-core and start Compose --profile webread.
# Search remains available without a configured reader.
WEB_READ=on

# Optional query for: node --env-file=deploy/websearch.env scripts/websearch-smoke.mjs
WEB_SEARCH_SMOKE_QUERY=SearXNG documentation search API

# Optional background crawler uses the same --profile webread isolated browsers.
# ONE web-service worker owns this volume. Retention: seven days.
WEB_CRAWL=off
# Host execution needs an absolute private directory; container defaults /data/webcrawl.
# WEB_CRAWL_DATA_DIR=/absolute/path/to/private/webcrawl
