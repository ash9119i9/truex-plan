# platform-next configuration. Copy to .env for local development.

# HTTP port. Separate from the old platform (4000).
PORT=4100

# MongoDB connection. Transactions need a replica set, even locally.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# Shared catalog database. Must start with "truex_next_" so this app can
# never point at the old platform's databases.
CATALOG_DB_NAME=truex_next_catalog

# Access tokens. The issuer and audience are fixed strings checked on every
# token; use different values per environment.
AUTH_ISSUER=https://api.truex.local
AUTH_AUDIENCE=truex-app
# Ed25519 signing key: run `npm run auth:generate-key` and paste both lines.
# The private key is a secret; never commit a real one.
AUTH_SIGNING_KEY_ID=
AUTH_SIGNING_KEY=
# Previous public keys still accepted during a rotation: id=key,id=key
AUTH_VERIFY_KEYS=
# Browser origins allowed to use the refresh cookie (exact, comma-separated).
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Google sign-in (Google Cloud console > APIs & Services > Credentials,
# OAuth client of type "Web application"). The secret is a secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered on the OAuth client and be on an AUTH_ALLOWED_ORIGINS
# origin; the frontend forwards it to /api/v1/auth/google/callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Chat (all four or none). The runtime adapter (runtime-adapter/) and its
# token; must equal the adapter's RUNTIME_ADAPTER_TOKEN.
RUNTIME_ADAPTER_URL=http://127.0.0.1:4400
RUNTIME_ADAPTER_TOKEN=
# The model gateway Codex calls, and the secret it verifies tokens with; must
# equal the gateway's MODEL_GATEWAY_SECRET.
MODEL_GATEWAY_URL=http://127.0.0.1:4200
MODEL_GATEWAY_SECRET=
