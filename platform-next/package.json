{
  "name": "platform-next",
  "version": "0.1.0",
  "private": true,
  "description": "Truex platform backend, rebuilt: users, tenants and memberships.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "operator": "node dist/cli/operator.js",
    "operator:dev": "tsx src/cli/operator.ts",
    "auth:generate-key": "tsx src/cli/generate-auth-key.ts",
    "connectors:generate-key": "tsx src/cli/generate-connectors-key.ts"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.14"
    }
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1141.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "mongodb": "6.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "mongodb-memory-server": "10.4.3",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
