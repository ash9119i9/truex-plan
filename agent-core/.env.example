PORT=4100
HOST=127.0.0.1
# All paths are resolved from the service directory.
PROJECT_ROOT=..
CODEX_HOME=../.runtime/codex
MAX_THREADS=20
REPLAY_LIMIT=500
REQUEST_TIMEOUT_MS=120000
RPC_TIMEOUT_MS=30000
# Runtime binary is taken exclusively from ../codex.lock.json.

# New conversations receive html_render; set false for registration rollback.
VISUAL_REPLIES_ENABLED=true
# Optional preview. AgentCore deployments use the private HTTP supervisor.
# Unconfigured preview is omitted; publication and legacy visuals still work.
HTML_PREVIEW_RUNNER=
HTML_PREVIEW_URL=
HTML_PREVIEW_SECRET=
# Local Docker mode only: pre-build this isolated worker image.
HTML_PREVIEW_IMAGE=truex-html-preview:local
