PORT=4100
HOST=127.0.0.1
# All paths are resolved from the service directory.
PROJECT_ROOT=..
CODEX_HOME=../.runtime/codex
MAX_THREADS=20
REPLAY_LIMIT=500
REQUEST_TIMEOUT_MS=120000
RPC_TIMEOUT_MS=30000
# Opt-in provider-independent WebSearch. Start the private services using
# deploy/websearch.compose.yaml, then open a NEW conversation.
WEB_SEARCH=
WEB_SERVICE_URL=http://127.0.0.1:4400
# Same random URL-safe token as the web-service (at least 32 characters).
WEB_SERVICE_TOKEN=
WEB_SEARCH_TIMEOUT_MS=20000
# Independent opt-in public page reading through the same private service.
WEB_READ=
WEB_READ_TIMEOUT_MS=50000
# Independent background crawl jobs. Existing chats require a NEW conversation.
WEB_CRAWL=
WEB_CRAWL_TIMEOUT_MS=15000
# Runtime binary is taken exclusively from ../codex.lock.json.
