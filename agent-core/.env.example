PORT=4100
HOST=127.0.0.1
# All paths are resolved from the service directory.
PROJECT_ROOT=..
CODEX_HOME=../.runtime/codex
MAX_THREADS=20
REPLAY_LIMIT=500
REQUEST_TIMEOUT_MS=120000
RPC_TIMEOUT_MS=30000
# Runtime binary is taken exclusively from ../codex.lock.json.
## Platform-managed MCP catalog/projection experiment. Applies to new/resumed threads.
## "omni" exposes four discovery/invocation tools; "direct" preserves native connectors.
## No end-user tool allowlists are required. See docs/OMNI_MCP_GATEWAY.md.
TRUEX_MCP_GATEWAY_MODE=direct
## In Omni mode, "required" makes the model choose fields or explicitly request ["*"].
## "optional" preserves the initial experiment for comparison. End users set neither.
TRUEX_MCP_GATEWAY_PROJECTION=optional
