PORT=4100
HOST=127.0.0.1
# All paths are resolved from the service directory.
PROJECT_ROOT=..
CODEX_HOME=../.runtime/codex
MAX_THREADS=20
REPLAY_LIMIT=500
REQUEST_TIMEOUT_MS=120000
RPC_TIMEOUT_MS=30000
# Runtime binary is taken exclusively from ../codex.lock.json.
## MCP connection method: direct, adaptive_v2, or omni. Restart after changing.
## Applies to new/resumed conversations. Direct preserves native connectors.
MCP_METHOD=direct
## In Omni mode, "required" makes the model choose fields or explicitly request ["*"].
## "optional" allows unprojected responses. This is an operator setting.
TRUEX_MCP_GATEWAY_PROJECTION=optional
