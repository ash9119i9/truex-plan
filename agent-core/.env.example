PORT=4100
HOST=127.0.0.1
# All paths are resolved from the service directory.
PROJECT_ROOT=..
CODEX_HOME=../.runtime/codex
MAX_THREADS=20
REPLAY_LIMIT=500
REQUEST_TIMEOUT_MS=120000
RPC_TIMEOUT_MS=30000
# Runtime binary is taken exclusively from ../codex.lock.json.
# Optional visual preview and publish-time measurement (off by default).
VISUAL_RENDER=0
# Absolute path to an installed Chromium binary. No browser is downloaded at runtime.
CHROMIUM_PATH=
# Explicit POC opt-in if the runtime cannot launch Chromium with its OS sandbox.
CHROMIUM_NO_SANDBOX=0
# Maximum simultaneous browser renders, 1..4 (default 2); queue size matches this limit.
VISUAL_RENDER_CONCURRENCY=2
