{
  "name": "agent-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:agentcore": "tsx watch src/agentcore.ts",
    "start": "node dist/agent-core/src/index.js",
    "start:agentcore": "node dist/agent-core/src/agentcore.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "docx": "^9.7.1",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  }
}
