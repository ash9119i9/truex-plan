PORT=4400
HOST=127.0.0.1
# Trusted private SearXNG base URL, never selected by a model argument.
SEARXNG_URL=http://127.0.0.1:8080
# Generate with `openssl rand -hex 32`; same value in agent-core/.env.
WEB_SERVICE_TOKEN=
SEARCH_TIMEOUT_MS=15000
SEARCH_MAX_CONCURRENT=4
# Optional trusted private narrow SDK worker; no Crawl4AI general-purpose API.
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
READ_TIMEOUT_MS=35000
READ_MAX_CONCURRENT=2
